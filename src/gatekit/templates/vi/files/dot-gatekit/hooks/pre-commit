#!/usr/bin/env bash
# pre-commit — gatekit. NHANH: chỉ guard FAST. fail-CLOSED: thiếu gatekit / guard ĐỎ / lỗi ⇒ chặn commit.
# Chỉ là máy KHÁCH (`--no-verify` đi vòng được) — pre-push và CI gác lại; luật dự án ⛔ dùng --no-verify.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
GATEKIT_BIN="${GATEKIT_BIN:-}"
if command -v gatekit >/dev/null 2>&1; then GK=(gatekit)
elif [ -n "$GATEKIT_BIN" ] && [ -x "$GATEKIT_BIN" ]; then GK=("$GATEKIT_BIN")
elif python3 -c "import gatekit" 2>/dev/null; then GK=(python3 -m gatekit)
else echo "pre-commit: 🔴 không tìm thấy gatekit (cài pip, hoặc chạy lại `gatekit hooks install` từ plugin)"; exit 1; fi
"${GK[@]}" check --fast || { echo "pre-commit: 🔴 gatekit check --fast ĐỎ"; exit 1; }
