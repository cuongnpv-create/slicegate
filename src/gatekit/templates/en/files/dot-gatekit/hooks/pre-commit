#!/usr/bin/env bash
# pre-commit — gatekit. FAST: only FAST guards. fail-CLOSED: gatekit missing / guard RED / error ⇒ commit blocked.
# Client-side only (`--no-verify` bypasses it) — pre-push and CI guard again; project rules forbid --no-verify.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
GATEKIT_BIN="${GATEKIT_BIN:-}"
if command -v gatekit >/dev/null 2>&1; then GK=(gatekit)
elif [ -n "$GATEKIT_BIN" ] && [ -x "$GATEKIT_BIN" ]; then GK=("$GATEKIT_BIN")
elif python3 -c "import gatekit" 2>/dev/null; then GK=(python3 -m gatekit)
else echo "pre-commit: 🔴 gatekit not found (pip install it, or re-run `gatekit hooks install` from the plugin)"; exit 1; fi
"${GK[@]}" check --fast || { echo "pre-commit: 🔴 gatekit check --fast RED"; exit 1; }
